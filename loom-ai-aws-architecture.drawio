        <mxCell id="step-8-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;GitHub import&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;loom github downloads a repository from api.github.com and indexes it for the team.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-8-legend">
          <mxGeometry height="66" width="548" x="52" as="geometry" />
        </mxCell>

        <mxCell id="legend-aux-note" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontStyle=2;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Auxiliary: the IAM instance role carries the policy in docs/AWS.md; CloudWatch collects the gateway's logs.&lt;/span&gt;" vertex="1" parent="legend-container">
          <mxGeometry height="44" width="600" x="0" y="716" as="geometry" />
