# Copy to .env. Every variable is optional; defaults run fully locally (no AWS).

LOOM_DATABASE_URL=postgresql://loom:loom@localhost:5433/loom

# Storage for raw files and sent artifacts: local folder by default, S3 when a bucket is set.
LOOM_BLOB_DIR=data/blobs
# LOOM_S3_BUCKET=loom-ai-artifacts

# Providers. Local defaults need no credentials; switch to bedrock once AWS keys exist.
LOOM_EMBEDDING_PROVIDER=hash        # hash | bedrock
LOOM_RERANK_PROVIDER=lexical        # lexical | bedrock
LOOM_LLM_PROVIDER=none              # none | bedrock | ollama

LOOM_AWS_REGION=us-east-1
# Verify model IDs and access in the Bedrock console for your region before switching.
# LOOM_BEDROCK_EMBEDDING_MODEL=cohere.embed-multilingual-v3
# LOOM_BEDROCK_FAST_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# LOOM_BEDROCK_ANSWER_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# LOOM_BEDROCK_RERANK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/cohere.rerank-v3-5:0
# LOOM_GUARDRAIL_ID=
# LOOM_GUARDRAIL_VERSION=DRAFT

# LOOM_OLLAMA_URL=http://localhost:11434
# LOOM_OLLAMA_MODEL=qwen3:14b

# Required to create the first team (workspace) when the server is reachable by others.
# LOOM_BOOTSTRAP_SECRET=
