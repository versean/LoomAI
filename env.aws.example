# Loom AI on AWS. On the EC2 instance:  cp deploy/.env.aws.example .env  then replace every CHANGE_ME.
# deploy/README.md says where to find each value. Never commit the filled-in .env or paste it into chat.
# There are no AWS keys here on purpose: the server uses the EC2 instance role.

# ── Server ────────────────────────────────────────────────────────────────────
LOOM_HOST=0.0.0.0
LOOM_PORT=8787

# Required because the server is public. Generate with:  openssl rand -hex 24
# Send it to Askar privately; he uses it once to create the team.
LOOM_BOOTSTRAP_SECRET=CHANGE_ME_BOOTSTRAP_SECRET

# true = anyone can start their own team without the secret (the hosted Loom AI). Teams are isolated,
# but every team's questions and uploads run on this account's Bedrock bill.
LOOM_OPEN_SIGNUP=false

# ── Database: RDS PostgreSQL 17 (pgvector 0.8+) ───────────────────────────────
# URL-encode the password if it contains @ : / ? # % or spaces.
LOOM_DATABASE_URL=postgresql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@CHANGE_ME_RDS_ENDPOINT:5432/CHANGE_ME_DB_NAME?sslmode=require

# ── Files: private S3 bucket with SSE-KMS default encryption ──────────────────
LOOM_S3_BUCKET=CHANGE_ME_BUCKET_NAME

# ── Region: the hackathon account only allows us-east-1 ───────────────────────
LOOM_AWS_REGION=us-east-1

# ── Models (Bedrock) ──────────────────────────────────────────────────────────
# If Bedrock access isn't ready yet, set these three to hash / lexical / none to deploy without it.
LOOM_EMBEDDING_PROVIDER=bedrock
LOOM_RERANK_PROVIDER=bedrock
LOOM_LLM_PROVIDER=bedrock

# Tested in the hackathon account (us-east-1) on Nov 7: all five work. "us." profiles work in US regions only (EU uses "eu.").
LOOM_BEDROCK_EMBEDDING_MODEL=cohere.embed-multilingual-v3
LOOM_BEDROCK_FAST_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
LOOM_BEDROCK_ANSWER_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# The region inside this ARN must match LOOM_AWS_REGION.
LOOM_BEDROCK_RERANK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/cohere.rerank-v3-5:0

# ── Guardrail (optional): uncomment both lines to enable ──────────────────────
# LOOM_GUARDRAIL_ID=CHANGE_ME_GUARDRAIL_ID
# LOOM_GUARDRAIL_VERSION=DRAFT
